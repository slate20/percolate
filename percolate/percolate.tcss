/* Ambient/state styling for the Farm & Roast screens (overview.md §4).
   Market and Upgrades stay plain — they're utility screens, not the "zen".

   Literal color names on purpose: theme variables like $warning aren't
   reliably resolved at CSS_PATH parse time (raises UnresolvedVariableError). */

.tint-bar {
    height: 1;
    dock: top;
    text-align: right;
    color: #b3b3b3;
    padding-right: 2;
}

/* Replaces Textual's default Footer (see widgets.NAV_HINT) — one slim,
   muted, always-the-same line instead of a loud per-screen key-chip bar. */
.nav-hint {
    dock: bottom;
    height: 1;
    color: #808080;
    text-align: center;
}

/* Screen-specific hint for Tab-cycling focus between a screen's controls
   (Market's four lists, Roast's builder panel) — MarketScreen/RoastScreen.
   Not docked, just an inline line in the normal flow, matching the
   "hinted inline next to what it acts on" convention rather than a footer. */
.section-hint {
    height: 1;
    color: #808080;
    margin-bottom: 1;
}

/* Wraps just the backdrop so it can be centered on its own — centering
   at the FarmScreen level instead would center the *combined* bounding
   box of every flow child (backdrop + #field), and #field already spans
   the full width itself, which would cancel the effect out.
   Scrollable so terminals smaller than the fixed canvas can pan around it
   via mouse wheel / scrollbar drag only (the widget is mounted with
   can_focus=False in FarmScreen.compose, so it never captures the
   plot-grid's arrow-key cursor bindings). Capped at the canvas's own
   height so it never crowds out the plot grid below it on tall terminals. */
#backdrop_wrap {
    height: auto;
    max-height: 21;
    align: center top;
}

/* Farm screen backdrop: fixed-size canvas (must match data/farmhouse.json's
   "canvas" block), assembled once at mount by
   backdrop_compositor.composite_backdrop — no longer size-adaptive.
   Textual's `width`/`height` are border-box sizes including padding, so
   both dimensions below need the padding added on top of the canvas's own
   80x20 (canvas width + 2 left padding, canvas height + 1 top padding) —
   otherwise text wraps/clips: a too-narrow content width silently wraps
   any row whose rightmost columns hold real glyphs (not blank filler)
   onto an extra line, which then pushes the fixed-height box's last rows
   off screen entirely. */
#backdrop {
    width: 82;
    height: 21;
    padding: 1 0 0 2;
}

#field {
    height: auto;
    padding: 1 2;
    grid-gutter: 1 2;
    /* Columns size to their content (not equal 1fr stretch across the full
       screen width) so the block of cards hugs its own width; `align`
       then centers that block within #field, which itself still spans the
       full screen. Column *count* is recomputed adaptively in
       FarmScreen._max_columns as the window/plot count changes. */
    grid-columns: auto;
    align: center top;
}

.plot-cell {
    border: round grey;
    width: 21;
    height: 13;
    content-align: center middle;
    text-align: center;
}

.plot-cell.cursor {
    border: round gold;
}

/* (o) toggle on FarmScreen — see FarmScreen.action_toggle_outline. Higher
   specificity than .plot-cell.cursor above so it wins without touching
   the "cursor" class itself (still used for the inline (enter) hint). */
#field.hide-cursor-outline .plot-cell.cursor {
    border: round grey;
}

/* Roast screen: three-column layout — a persistent bean/flavor/level
   builder on the left, the ambient roaster art in the center, and the
   discovered-recipe log on the right (see screens/roast_screen.py). */
#roast_layout {
    height: 1fr;
}

#builder_panel {
    width: 34;
    padding: 1 2;
    border-right: solid #4d4d4d;
}

#builder_panel OptionList, #builder_panel SelectionList {
    height: auto;
    max-height: 6;
    margin-bottom: 1;
}

.builder-heading {
    text-style: bold;
    color: #b3b3b3;
}

.builder-status {
    margin: 1 0;
    color: khaki;
}

#center_panel {
    width: 1fr;
}

#roaster_field {
    height: auto;
    padding: 1 2;
    grid-gutter: 1 2;
    align: center top;
}

/* Roaster cards run larger than plot cards — there are always far fewer
   roaster slots than plots, so each one can afford more visual weight.
   height is auto rather than fixed: #roaster_field's Grid sizes each auto
   row from the actual line count each cell renders (a plain Static's
   declared `height` isn't consulted for that — see
   RoastScreen._wrap_header, which pre-wraps long roast names into real
   newlines so the card grows to fit instead of clipping them). */
.roast-cell {
    border: round grey;
    width: 33;
    height: auto;
    content-align: center middle;
    text-align: center;
}

#no_roaster {
    color: #8a8a8a;
    text-align: center;
    content-align: center middle;
    width: 40;
    height: 8;
    border: round grey;
}

#recipe_panel {
    width: 32;
    padding: 1 2;
    border-left: solid #4d4d4d;
}

.recipe-entry {
    margin-bottom: 1;
    text-align: center;
}

/* Market screen: plain utility layout (see screens/market_screen.py) — no
   ambient art or tint, that "zen" budget stays on Farm/Roast. Buying and
   selling are simply split left/right; each side is otherwise the same
   bare Label + ListView stack as before. */
#buy_column {
    width: 1fr;
    padding: 1 2;
    border-right: solid #4d4d4d;
}

#sell_column {
    width: 1fr;
    padding: 1 2;
}

/* Every modal in the app (bean/ingredient/roast-level pickers, the
   contextual upgrade shop) composes a Vertical with this id — without
   sizing, a Vertical fills the whole screen instead of reading as a
   popup, so give it a bounded, centered box. */
#picker {
    width: 70;
    height: auto;
    max-height: 24;
    padding: 1 2;
    border: round grey;
}

/* HelpModal — same bounded-popup idea as #picker, but a guide needs more
   room and its own scrollbar rather than #picker's fixed max-height. */
#help_picker {
    width: 76;
    height: 34;
    padding: 1 3;
    border: round grey;
}

/* UpgradeModal only: title left, gold readout right — see
   UpgradeModal.compose for why this needs its own gold display. */
#modal_header {
    height: auto;
}

#modal_title {
    width: 1fr;
}

#modal_gold {
    width: auto;
    color: gold;
    text-style: bold;
}

ModalScreen {
    align: center middle;
}

.tod-morning { background: gold 12%; }
.tod-midday { background: white 4%; }
.tod-evening { background: darkorange 14%; }
.tod-night { background: slateblue 18%; }

.ambient-bar {
    height: 1;
    color: grey;
}

/* Plot / batch state colors — dim when empty or just starting,
   warming with progress, bright at ready. */
.state-empty {
    color: grey;
}

.state-early {
    color: darkgreen;
}

.state-mid {
    color: darkorange;
}

.state-ready {
    color: gold;
    text-style: bold;
}

/* Roast progress: idle -> green -> yellow -> brown -> dark -> ready. */
.roast-idle {
    color: grey;
}

.roast-green {
    color: green;
}

.roast-yellow {
    color: khaki;
}

.roast-brown {
    color: sienna;
}

.roast-dark {
    color: firebrick;
}

.roast-ready {
    color: gold;
    text-style: bold;
}
